{
  "name": "@aep/ae-design-agent",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Interactive spec agents (Vercel AI SDK). Seeded with the main file-mutation agent.",
  "exports": {
    "./server": "./src/edge/routes.ts",
    "./edge/authenticate": "./src/edge/authenticate.ts",
    "./edge/turn-socket": "./src/edge/turn-socket.ts",
    "./turns/start-turn": "./src/turns/start-turn.ts",
    "./turns/turn-desk": "./src/turns/turn-desk.ts",
    "./conversations/thread-book": "./src/conversations/thread-book.ts",
    "./conversations/marketplace-book": "./src/conversations/marketplace-book.ts",
    "./tools-socket/client": "./src/tools-socket/client.ts",
    "./tools-socket/fake": "./src/tools-socket/fake.ts",
    "./store/conversation-store": "./src/store/conversation-store.ts",
    "./shared/config": "./src/shared/config.ts",
    "./shared/env": "./src/shared/env.ts",
    "./shared/hash": "./src/shared/hash.ts",
    "./shared/listen": "./src/shared/listen.ts",
    "./shared/model": "./src/shared/model.ts",
    "./shared/snapshot-path": "./src/shared/snapshot-path.ts",
    "./shared/mock-model": "./src/shared/mock-model.ts",
    "./conversation/load-workspace": "./src/conversation/load-workspace.ts"
  },
  "scripts": {
    "gen": "openapi-typescript ../../../../../packages/contracts/api/ae-design-agent/v1/openapi.yaml -o src/generated/api.d.ts && openapi-typescript ../../../../../packages/contracts/sockets/ae-studio/mcp/openapi.yaml -o src/generated/mcp-socket.d.ts && openapi-typescript ../../../../../packages/contracts/sockets/ae-studio/turn/openapi.yaml -o src/generated/turn-socket.d.ts && tsx scripts/generate-prototype-skill.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.0",
    "@ai-sdk/devtools": "^1.0.4",
    "@ai-sdk/openai-compatible": "^3.0.55",
    "@aep/agent-stream": "workspace:*",
    "@aep/collab-doc": "workspace:*",
    "@aep/platform-idp-auth": "workspace:*",
    "@aep/web-search": "workspace:*",
    "@wso2/prototype-kit": "workspace:*",
    "@wso2/prototype-theme-oxygen": "workspace:*",
    "@hocuspocus/provider": "^4.3.0",
    "ai": "^7.0.2",
    "express": "^5.0.0",
    "jose": "^5.9.0",
    "undici": "^7.29.1",
    "unpdf": "^1.8.1",
    "ws": "^8.18.0",
    "yaml": "^2.8.4",
    "yjs": "^13.6.31",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@aep/sse-cassette": "workspace:*",
    "@hocuspocus/server": "^4.3.0",
    "@types/express": "^5.0.0",
    "@types/node": "^25.6.0",
    "@types/ws": "^8.18.0",
    "@wso2/prototype-theme-default": "workspace:*",
    "tsx": "^4.21.0"
  }
}
