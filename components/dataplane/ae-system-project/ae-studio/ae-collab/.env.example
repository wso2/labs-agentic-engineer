# components/dataplane/ae-system-project/ae-studio/ae-collab — Yjs collaboration server (#86)

# WebSocket listen port. docker-compose runs the service at 3400 (the console
# nginx's default `collab-server:3400` upstream).
COLLAB_PORT=8091

# BFF base URL incl. API prefix. With no BFF (real or mock) and no COLLAB_DEV
# the server refuses to start.
#AEP_API_BASE=http://localhost:9090/api/v1

# Dev mode: skip the BFF oracle, seed rooms from fixtures. Explicit only
# (`pnpm dev` sets it). Never in cluster.
#COLLAB_DEV=1

# Embedded mock BFF: real auth/seed code paths against a fixture-backed
# stand-in for #81 / #86 phase 2. Overrides AEP_API_BASE. Never in cluster.
#COLLAB_MOCK_BFF=1
#COLLAB_MOCK_BFF_PORT=8092

# Committer: flush cadence — a quiet period commits the room's changes as one
# bot commit via the BFF's files/apply; the max cap bounds the wait during
# continuous editing. The final flush runs when the last participant leaves
# (D6 residual: ≤60s window if no client remains for token refresh).
COLLAB_COMMIT_DEBOUNCE_MS=60000
COLLAB_COMMIT_MAX_DEBOUNCE_MS=300000

# Ops: GET /healthz → 200 ok. Cluster runs replicas:1 with probes on /healthz.
