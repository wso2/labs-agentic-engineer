{
  "name": "remote-worker",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "tsx src/oneshot.ts",
    "build": "tsc",
    "gen": "openapi-typescript ../../packages/contracts/api/v1/openapi.yaml -o src/generated/aep-api.d.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.247",
    "@opencode-ai/sdk": "1.18.32",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "esbuild": "0.28.1"
  }
}
