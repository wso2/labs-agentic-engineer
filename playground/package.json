{
  "name": "@aep/playground",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Root-level local-filesystem playground: runs the real engineering + coding agents against a plain project directory (docs/design/playground.md).",
  "scripts": {
    "play": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "dev": "echo \"@aep/playground: run via pnpm play\""
  },
  "dependencies": {
    "@aep/agent-stream": "workspace:*",
    "@aep/agents": "workspace:*",
    "@aep/contracts": "workspace:*",
    "@aep/design-projection": "workspace:*",
    "@aep/excalidraw-dsl": "workspace:*",
    "@aep/progress-view": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.247",
    "@clack/prompts": "^1.6.0",
    "ai": "^7.0.2",
    "jose": "^5.9.0",
    "smol-toml": "^1.7.1",
    "yaml": "^2.8.4"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0"
  }
}
