{
  "version": 3,
  "permissions": [
    {
      "resource": "orders",
      "component": "orders-api",
      "description": "Customer orders",
      "actions": [
        { "handle": "read", "description": "The caller's own orders" },
        { "handle": "read-all", "description": "Every order" }
      ]
    }
  ],
  "groups": [{ "name": "Staff", "description": "Order desk" }],
  "roles": [
    { "name": "Customer", "description": "Places orders", "stories": [1], "grants": ["orders:read"], "assignTo": ["Staff"] },
    { "name": "OrderDesk", "description": "Sees every order", "stories": [2], "grants": ["orders:read", "orders:read-all"], "assignTo": ["Staff"] }
  ],
  "testUsers": [{ "username": "test-customer", "roles": ["Customer"] }]
}
