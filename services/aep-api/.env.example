# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=info

# OpenChoreo Platform API (required)
PLATFORM_API_SERVICE_BASE_URL=http://api.openchoreo.localhost:8195
PLATFORM_API_SERVICE_HOST=

# Database (for future use)
DATABASE_URL=postgres://aep:aep@localhost:5432/aep?sslmode=disable

# Gates ClusterResourceType catalog discovery. Default true (core capability).
# Set false when the deployment offers no platform-resource catalog — List
# returns [] without calling OpenChoreo. Local ships unset (enabled).
#PLATFORM_RESOURCES_ENABLED=true

# Runner image — ONE image for BOTH task kinds (implementation and
# validation). There is no default and no fallback: empty
# makes dispatch fail loudly. Local dev builds + k3d-imports aep-runner:dev via
# `make build-runner`; released platforms use ghcr.io/wso2/aep/remote-worker:<v>.
AGENT_RUNNER_IMAGE=aep-runner:dev

# The OpenCode runner image — the same Dockerfile's runner-opencode stage (the
# image above plus the pinned OpenCode binary), used for an organization whose
# coding-agent runtime is OpenCode. No default: empty makes an OpenCode cycle's
# dispatch fail naming this variable. Local dev builds aep-runner-opencode:dev
# beside aep-runner:dev.
AGENT_RUNNER_IMAGE_OPENCODE=aep-runner-opencode:dev

# How far apart (Go duration) the two "no pod" reads must be before a closed
# coding cycle's Component is deleted. One empty read is never enough: the
# resource tree can answer empty under load.
CODING_AGENT_SETTLE_GRACE=5m

# How long the observability plane keeps pod logs (Go duration). A coding cycle
# that ended longer ago reports its log as `expired` and is not read.
OBSERVER_LOG_RETENTION=72h

# How long a finished coding-agent Job (and its pod) is kept before Kubernetes
# deletes it (Go duration; rendered as the Job's ttlSecondsAfterFinished).
CODING_AGENT_JOB_TTL=600s

# Inbound JWT verifier — Thunder JWKS endpoint for User/Service JWT validation.
# Required at boot (Validate rejects empty); every /api/ request 401s without it.
JWKS_URL=http://thunder.openchoreo.localhost:8080/oauth2/jwks
# Accepted aud on /api/v1: the console client, the issuer of user tokens.
# client_credentials tokens are refused there whatever their aud.
JWT_AUDIENCE=aep-console-client

# The OpenChoreo SRE agent's handoff (docs/developer-guide/sre-handoff-security.md):
# the key the agent authenticates to its MCP tools (POST
# /internal/v1/sre-handoff/mcp) with; at least 32 characters, from a Secret
# only, never logged. `aectl sre install` sets it through the platform Helm
# chart's sreAgent values. Each call names its org, which aep-api verifies
# against the observer's alerts, so the handoff also needs OBSERVER_URL and
# SERVICE_AUTH_*. Unset, the handoff is not mounted and no auto-RCA alert rule
# is attached.
SRE_HANDOFF_TOKEN=

# PLATFORM-tier Thunder admin client (clients/thundersvc) — mints scope=system
# tokens for the per-org publisher OAuth apps and the OU validator, and NOTHING
# else. Roles and test users live on the environment tier below. Empty admin URL
# falls back to the SERVICE_AUTH_TOKEN_URL host. The resource identifier names
# ThunderID's System resource server, the one that owns the `system` scope;
# empty derives "<PLATFORM_IDP_ISSUER>/mcp" (ThunderID's convention). Set it
# only when the IdP registered a non-conventional identifier.
THUNDER_ADMIN_URL=http://thunder.openchoreo.localhost:8080
THUNDER_SYSTEM_CLIENT_ID=aep-system-client
THUNDER_SYSTEM_CLIENT_SECRET=aep-system-client-secret
THUNDER_SYSTEM_RESOURCE_IDENTIFIER=

# Which address admin calls to an ENVIRONMENT's Thunder go to. There is one per
# (org, environment), and no credentials for them are configured here at all:
# each binding is read per call from its OpenChoreo Environment's
# aep.wso2.com/thunder-* annotations plus the credential at OPENBAO_ADDR (see
# deployments/scripts/setup-environment-thunder.sh).
#
# Unset, it follows where aep-api runs: `binding` in a pod, `issuer` otherwise.
#
#   issuer   the instance's PUBLIC issuer, e.g.
#            http://default-idp.amp.localhost:8080. The only address that
#            works from docker compose, where aep-api is outside the cluster and
#            the binding's *.svc.cluster.local admin URL resolves to nothing.
#            The compose service needs an extra_hosts entry per environment.
#   binding  the in-cluster Service address the binding records. Right for an
#            aep-api running INSIDE the cluster, where those public hostnames do
#            not resolve from a pod.
THUNDER_ENV_ADMIN_ROUTE=issuer

# On-disk platform skill library seeded/reconciled into each org's skills repo.
# COPY'd into the image from repo-root skills/ (default /app/skills). Set this
# when running the binary outside the container (e.g. point at ../../skills).
SKILLS_DIR=/app/skills

# Temporal (devflow workflows). Unset TEMPORAL_HOSTPORT disables the feature:
# no worker starts and the /devflows endpoints answer 503 temporal_unavailable.
TEMPORAL_HOSTPORT=host.docker.internal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASKQUEUE=aep-devflow

# Local-only OpenBao connection for the in-process OpenBao-direct secrets
# provider (NewOSSOptions). Empty = secrets delivery off. Never set in cloud.
OPENBAO_ADDR=http://host.docker.internal:8200
# No static token: aep-api logs in by Kubernetes auth as service account
# aep-api in wso2-aep (role and write-only policy from
# deployments/scripts/openbao-aep-api-auth.sh). In a pod the token is the
# projected one at the default path. A host-run aep-api needs a short-lived
# token file for that service account, made with
#   kubectl -n wso2-aep create token aep-api --duration=1h > <file>
# (chmod 600 it; re-create it when it expires).
# OPENBAO_AUTH_ROLE=aep-api
# OPENBAO_AUTH_MOUNT=kubernetes
# OPENBAO_AUTH_TOKEN_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token

# OVERRIDE for host:port of the API Platform gateway runtime — the hop that
# terminates end-user auth for a managed API. Published to a consumer of a
# PROTECTED sibling as <DEP>_GATEWAY_URL so a SPA's nginx proxies the browser's
# /api through it instead of straight at the project Service.
#
# Leave it EMPTY. The platform runs one gateway per (org, environment) and the
# address is derived per deploy — api-platform-<org>-<env>-gw-gateway-gateway-
# runtime.<org>-<env>.svc.cluster.local:22893 — mirroring the api-configuration
# ClusterTrait's Backend host. A value set here wins for every environment, so
# it is only correct for a data plane that names its gateway differently.
#API_GATEWAY_HOST=

# Kubernetes API for ThunderApplication CR GETs (deploy-wait). Helm pods get
# https://$KUBERNETES_SERVICE_HOST:$KUBERNETES_SERVICE_PORT automatically.
# Local compose leaves these unset so the thunder wait stays skipped.
#KUBE_API_BASE_URL=
# Optional bearer override (defaults to the in-cluster SA token file when present).
#KUBE_API_BEARER=
