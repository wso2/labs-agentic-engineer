# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
LOG_LEVEL=info

# OpenChoreo Platform API (required)
PLATFORM_API_SERVICE_BASE_URL=http://api.openchoreo.localhost:8195
PLATFORM_API_SERVICE_HOST=

# Database (for future use)
DATABASE_URL=postgres://aep:aep@localhost:5432/aep?sslmode=disable

# Test mode — enables test-only endpoints
TEST_MODE=false

# Gates POST /internal/v1/mcp/playground-token — mints a short-lived MCP
# token with NO caller auth, for a human driving services/agents' playground
# CLI locally. Off by default (route absent, 404); only
# deployments/docker-compose.yml sets this true.
PLAYGROUND_TOKEN_ENABLED=false

# Git host provider (clients/<provider> behind gitrepo's ports). Only "github"
# is supported today; boot fails on any other value.
GIT_PROVIDER=github

# NEW file-mutation agents service (services/agents) — requirements/design/chat
# generation. AGENTS_SVC_JWT_SECRET must match the service's AGENT_JWT_SECRET.
AGENTS_SVC_BASE_URL=http://agents:4000
AGENTS_SVC_JWT_SECRET=dev-agents-m2m-secret
AGENTS_SVC_JWT_AUDIENCE=agents-service
AGENTS_SVC_JWT_ISSUER=aep-bff

# Shared git workspaces (docs/design/shared-volume-clone-architecture.md).
# Mount root for the bare repo mirrors + per-SHA snapshots; aep-api is the
# sole writer of this volume (agents mounts it read-only).
AEP_WORKSPACE_ROOT=/workspaces
# Reaper sweep cadence (trash purge, snapshot age-reap, orphan + quota passes).
AEP_WORKSPACE_REAP_INTERVAL=5m
# Snapshots older than this (and not the repo's current HEAD) are reaped.
AEP_WORKSPACE_SNAPSHOT_MAX_AGE=24h
# Trashed subtrees (two-phase delete) are purged after this age.
AEP_WORKSPACE_TRASH_MAX_AGE=24h
# Per-org disk quota in bytes (default 5GiB) before LRU snapshot/mirror eviction.
AEP_WORKSPACE_ORG_QUOTA_BYTES=5368709120
# Disk-usage high-water mark (%) that triggers eviction…
AEP_WORKSPACE_DISK_HIGH_PCT=85
# …and the low-water mark (%) eviction drives usage back under.
AEP_WORKSPACE_DISK_LOW_PCT=70

# Temporal orchestrator (dial-only client). The BFF starts/signals/queries
# development-flow workflows executed by services/orchestrator; it runs no worker.
# HOST_PORT is the Temporal frontend gRPC address (docker-compose: temporal:7233;
# host: localhost:7233). NAMESPACE + TASK_QUEUE must match the orchestrator.
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=aep-orchestrator

# Shared secret the orchestrator's activities present on every call to
# /internal/v1/orchestration/*. Must be byte-identical to the orchestrator's
# own AEP_API_INTERNAL_BEARER (services/orchestrator/.env.example). Empty
# leaves the surface unauthenticated (every request 503s) — set it outside
# pure-loopback local dev.
AEP_API_INTERNAL_BEARER=
