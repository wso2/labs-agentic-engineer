{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "buildpack": {
      "type": "string",
      "minLength": 1
    },
    "appPath": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "exposure": {
      "type": "string",
      "enum": [
        "internet",
        "intranet"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "component",
              "org-service",
              "external",
              "platform-resource"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "resourceType": {
            "type": "string"
          },
          "parameters": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "boolean"
                }
              ]
            }
          },
          "wiring": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "ref": {
                    "type": "string",
                    "minLength": 1
                  },
                  "envBindings": {
                    "type": "object",
                    "propertyNames": {
                      "type": "string"
                    },
                    "additionalProperties": {
                      "type": "string"
                    }
                  }
                },
                "required": [
                  "ref",
                  "envBindings"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "endpoint": {
                    "type": "object",
                    "properties": {
                      "component": {
                        "type": "string",
                        "minLength": 1
                      },
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "visibility": {
                        "type": "string",
                        "minLength": 1
                      },
                      "envBindings": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {
                          "type": "string"
                        }
                      }
                    },
                    "required": [
                      "component",
                      "name",
                      "visibility",
                      "envBindings"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "endpoint"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "endpoint": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "exposesAPI": {
      "type": "object",
      "properties": {
        "managed": {
          "type": "boolean"
        },
        "auth": {
          "type": "string"
        },
        "userContext": {
          "type": "string"
        },
        "orgPublished": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "componentAgentInstructions": {
      "type": "string"
    },
    "stories": {
      "type": "array",
      "items": {
        "type": "integer",
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991
      }
    },
    "skillsPinned": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "type",
    "version",
    "language",
    "buildpack",
    "appPath",
    "entrypoint",
    "exposure",
    "dependencies",
    "description"
  ],
  "additionalProperties": false
}
