{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "minLength": 1
    },
    "buildpack": {
      "type": "string",
      "minLength": 1
    },
    "appPath": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": "string",
      "minLength": 1
    },
    "exposure": {
      "type": "string",
      "enum": [
        "internet",
        "intranet"
      ]
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "component",
              "org-service",
              "external",
              "platform-resource"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "needsSpec": {
            "type": "boolean"
          },
          "specPath": {
            "type": "string"
          },
          "specUrl": {
            "type": "string"
          },
          "config": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "key": {
                  "type": "string",
                  "minLength": 1
                },
                "secret": {
                  "type": "boolean"
                },
                "credentialClass": {
                  "type": "string"
                }
              },
              "required": [
                "key"
              ],
              "additionalProperties": false
            }
          },
          "resourceType": {
            "type": "string"
          },
          "parameters": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "string"
            }
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "label": {
                  "type": "string",
                  "minLength": 1
                },
                "description": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              },
              "required": [
                "label"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "exposesAPI": {
      "type": "object",
      "properties": {
        "managed": {
          "type": "boolean"
        },
        "auth": {
          "type": "string"
        },
        "userContext": {
          "type": "string"
        },
        "orgPublished": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "componentAgentInstructions": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "type",
    "version",
    "language",
    "buildpack",
    "appPath",
    "entrypoint",
    "exposure",
    "dependencies",
    "description"
  ],
  "additionalProperties": false
}
