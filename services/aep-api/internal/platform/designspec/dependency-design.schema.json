{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "resource": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "config": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "secret": {
                "type": "boolean"
              },
              "description": {
                "type": "string"
              },
              "defaultValue": {
                "type": "string"
              }
            },
            "required": [
              "key"
            ],
            "additionalProperties": false
          }
        },
        "contract": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "openapi",
                "graphql",
                "sdk",
                "asyncapi",
                "protobuf",
                "documentation"
              ]
            },
            "path": {
              "type": "string",
              "minLength": 1
            },
            "origin": {
              "type": "string",
              "enum": [
                "registry",
                "provider",
                "derived",
                "assumed"
              ]
            },
            "accepted": {
              "type": "object",
              "properties": {
                "by": {
                  "type": "string",
                  "minLength": 1
                },
                "at": {
                  "type": "string",
                  "minLength": 1
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "by",
                "at"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "type",
            "path"
          ],
          "additionalProperties": false
        },
        "consumptionInstructions": {
          "type": "string"
        },
        "provenance": {
          "type": "object",
          "properties": {
            "sourceUrl": {
              "type": "string"
            },
            "registry": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "readOn": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sourceUrl": {
          "type": "string"
        },
        "registry": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "readOn": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "style": {
            "type": "string",
            "enum": [
              "rest-api",
              "graphql",
              "sdk"
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "resource"
  ],
  "additionalProperties": false
}
