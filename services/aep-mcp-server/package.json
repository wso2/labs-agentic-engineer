{
  "name": "@aep/aep-mcp-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Streamable-HTTP MCP server wrapping aep-api's SRE handoff issue endpoints, so external agents (e.g. the OpenChoreo SRE/RCA agent) can file GitHub issues for AE handling.",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.24.0",
    "express": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0"
  }
}
