    {
      "type": "text",
      "id": "d2_untrust_note",
      "x": 80,
      "y": 800,
      "width": 640,
      "height": 180,
      "text": "Named only (stay off Cloud or inherited):\nN1  Playground token and /_dev\nN2  SRE / RCA agent and aep-mcp-server\nN3  Test-user password reveal\nN4  Org GitHub PAT as primary path\nN6  Thunder / Kubernetes / OpenChoreo platform",
      "originalText": "Named only (stay off Cloud or inherited):\nN1  Playground token and /_dev\nN2  SRE / RCA agent and aep-mcp-server\nN3  Test-user password reveal\nN4  Org GitHub PAT as primary path\nN6  Thunder / Kubernetes / OpenChoreo platform",
      "fontSize": 15,
      "fontFamily": 3,
