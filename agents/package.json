{
  "name": "agents",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server/index.ts",
    "start": "tsx src/server/index.ts",
    "serve": "tsx src/server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "eval": "tsx --test \"src/**/*.eval.ts\"",
    "eval:architect": "tsx --test \"src/agents/architect/*.eval.ts\"",
    "eval:tech-lead": "tsx --test \"src/agents/tech-lead/*.eval.ts\"",
    "eval:functional-requirements": "tsx --test \"src/skills/document-generation/functional-requirements.eval.ts\""
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.71",
    "ai": "^6.0.168",
    "express": "^5.1.0",
    "jose": "^5.9.0",
    "yaml": "^2.8.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^25.6.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  }
}
