go 1.26.0

use (
	./deployments/single-cluster/resource-types/thunder-app/operator
	// Go workspace spanning every in-repo Go module. A change in a shared Go
	// package is picked up on the next build with no `replace` directives.
	//
	// Modules are added here as they are created. The root Makefile discovers
	// workspace modules dynamically, so adding a `use` line is the only edit
	// needed to adopt a new Go module.
	./services/aep-api
	./tools/aectl
)
