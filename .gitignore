# Dependencies
node_modules/

# Build output
dist/
build/
# …but never Go source packages named "build" (the unanchored pattern above
# would silently swallow them from every commit). The build package moved from
# a feature to the delivery domain's buildpipe sub-package in P6.
!services/aep-api/internal/delivery/build/
*.tsbuildinfo

# Turborepo
.turbo/

# Vite's dependency pre-bundle cache. Normally lands in node_modules/.vite (already
# ignored above), but Vite falls back to <root>/.vite — so running the dev server
# from inside an app directory leaves an untracked cache behind.
**/.vite/

# Generated code (source of truth is the contract; regenerated by `make gen`)
generated/
*.gen.go
# …except the OpenChoreo API client: generated once from a pinned upstream
# spec via `make -C services/aep-api gen-oc-client` (network fetch, not part
# of `make gen`), so it must be checked in for builds to be reproducible.
!services/aep-api/internal/clients/openchoreo/gen/*.gen.go

# Env / secrets
.env
.env.*
!.env.example

# Dev playground threads (services/agents/playground)
chat_playground/

# Editor / OS
.DS_Store
*.log
.playwright-cli
.playwright-mcp
**/.agents/settings.local.json
**/.claude/settings.local.json
e2e_test_run.txt
new_spec.yml

# Personal learning notes (not part of the project)
learning/

# Git worktrees for isolated agent/dev work
.worktrees/

# Vitest browser-mode run artifacts (failure screenshots + attachments)
**/__screenshots__/
**/.vitest-attachments/
.scratch/
.agents/worktrees/

# Scheduled-task runtime lock (machine-local: pid + sessionId)
.agents/scheduled_tasks.lock

# AI SDK DevTools captures (playground runs with AGENT_DEVTOOLS always on)
.devtools/

# Playground project homes (pnpm play default) — never repo sources
playground/.projects/
# Playground per-project state — belt-and-braces: an accidental run anywhere
# inside the repo must never become committable
.aep-playground/

# Draft design notes (scratch, not part of the committed design record)
docs/design/draft/

# Per-developer local chart overrides (copy from values.local.dev.yaml.example)
deployments/helm-charts/platform/values.local.dev.yaml

# Local build output of the dev secret-manager stub (15MB binary; rebuild with
# `GOWORK=off go build -o local-secret-manager-api .` in that directory).
deployments/local-secret-manager-api/local-secret-manager-api

# Compiled aepctl binary (built by `go build` in tools/aepctl)
tools/aepctl/aepctl

# Compiled setup-local binary (built from deployments/scripts)
deployments/scripts/setup-local

# Local PR-evidence screenshots (attached to PRs by hand, never committed)
/.screenshots/
/.screenshots-*/
# Local session artifacts — dev-tool config and working notes, not repo content
/.agents/launch.json
/docs/superpowers/

# aider's local repo-map cache — a tool's scratch, never source.
.aider.tags.cache.v*/
.aider*

.devtools
/.idea/.gitignore
/.idea/go.imports.xml
/.idea/golinter.xml
/.idea/modules.xml
/.idea/inspectionProfiles/Project_Default.xml
/.idea/vcs.xml
/.idea/wso2-agentic-engineer-2.iml

# Ballerina eval sweeps: scratch packages, transcripts and reports (on-demand, never CI)
evals/ballerina/.runs/
