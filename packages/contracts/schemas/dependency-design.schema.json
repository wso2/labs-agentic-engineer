{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "project",
        "org"
      ]
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "style": {
      "type": "string",
      "enum": [
        "rest-api",
        "graphql",
        "sdk"
      ]
    },
    "contract": {
      "type": "string",
      "minLength": 1
    },
    "sdk": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "properties": {
        "sourceUrl": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fetchedAt": {
          "type": "string"
        },
        "sliced": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "style": {
            "type": "string",
            "enum": [
              "rest-api",
              "graphql",
              "sdk"
            ]
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": false
      }
    },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "secret": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "defaultValue": {
            "type": "string"
          }
        },
        "required": [
          "key"
        ],
        "additionalProperties": false
      }
    },
    "assumed": {
      "type": "object",
      "properties": {
        "by": {
          "type": "string",
          "minLength": 1
        },
        "at": {
          "type": "string",
          "minLength": 1
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "by",
        "at"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "name"
  ],
  "additionalProperties": false
}
