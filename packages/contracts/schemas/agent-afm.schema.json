{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "spec_version": {
      "type": "string",
      "const": "0.4.0"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "max_iterations": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "model": {
      "type": "object",
      "properties": {
        "provider": {
          "type": "string",
          "enum": [
            "anthropic",
            "openai"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^\\$\\{env:[A-Za-z_][A-Za-z0-9_]*\\}$"
        },
        "authentication": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "api-key"
            },
            "api_key": {
              "type": "string",
              "pattern": "^\\$\\{env:[A-Za-z_][A-Za-z0-9_]*\\}$"
            }
          },
          "required": [
            "type",
            "api_key"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "provider",
        "name",
        "url",
        "authentication"
      ],
      "additionalProperties": false
    },
    "interfaces": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "webchat"
          },
          "exposure": {
            "type": "object",
            "properties": {
              "http": {
                "type": "object",
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "path"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "http"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "type"
        ],
        "additionalProperties": false
      }
    },
    "x-aep": {
      "type": "object",
      "properties": {
        "tools": {
          "type": "object",
          "properties": {
            "openapi": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "component": {
                    "type": "string",
                    "minLength": 1
                  },
                  "baseUrl": {
                    "type": "string",
                    "pattern": "^\\$\\{env:[A-Za-z_][A-Za-z0-9_]*\\}$"
                  },
                  "allow": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "component",
                  "baseUrl",
                  "allow"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "openapi"
          ],
          "additionalProperties": false
        },
        "memory": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "enum": [
                "client",
                "server"
              ]
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        "identity": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "on-behalf-of",
                "agent"
              ]
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "spec_version",
    "name",
    "description",
    "model",
    "interfaces"
  ],
  "additionalProperties": false
}
