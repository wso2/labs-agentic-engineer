{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number",
      "const": 2
    },
    "permissions": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource": {
            "type": "string",
            "minLength": 1
          },
          "component": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "actions": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "handle": {
                  "type": "string",
                  "minLength": 1
                },
                "ownership": {
                  "type": "string",
                  "enum": [
                    "own",
                    "any"
                  ]
                },
                "description": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "handle",
                "ownership"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "resource",
          "component",
          "actions"
        ],
        "additionalProperties": false
      }
    },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "description"
        ],
        "additionalProperties": false
      }
    },
    "roles": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "stories": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            }
          },
          "grants": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assignTo": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "enrolment": {
            "type": "string",
            "enum": [
              "admin",
              "self-service"
            ]
          },
          "assignableBy": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "kind": {
            "type": "string",
            "enum": [
              "user",
              "service"
            ]
          }
        },
        "required": [
          "name",
          "description",
          "stories",
          "grants"
        ],
        "additionalProperties": false
      }
    },
    "screens": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "component": {
            "type": "string",
            "minLength": 1
          },
          "screen": {
            "type": "string",
            "minLength": 1
          },
          "requires": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "component",
          "screen",
          "requires"
        ],
        "additionalProperties": false
      }
    },
    "testUsers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1
          },
          "roles": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "username",
          "roles"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "permissions",
    "groups",
    "roles",
    "screens",
    "testUsers"
  ],
  "additionalProperties": false
}
