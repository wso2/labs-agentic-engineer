{
  "about": "A requirement line's inline markdown and the text the collab room holds for it (the console reads that text). `text` was generated by the room's parser (@aep/collab-doc markdownToNode: @tiptap/markdown, which uses marked). `tag` is the closing tag the line keeps, when it has one. Held on both sides: aep-api reqspec (inline_test.go) and the console (spec/collab/inlineMarkup.test.ts).",
  "cases": [
    {
      "name": "code span",
      "markdown": "Greet with a `name` query parameter.",
      "text": "Greet with a name query parameter."
    },
    {
      "name": "code span, literal content",
      "markdown": "Match ``a\\*b ` c`` and `&amp;` as typed.",
      "text": "Match a\\*b ` c and &amp; as typed."
    },
    {
      "name": "code span, padded",
      "markdown": "Run `` `tick` `` here.",
      "text": "Run `tick` here."
    },
    {
      "name": "strong",
      "markdown": "Greet **every** caller, __always__.",
      "text": "Greet every caller, always."
    },
    {
      "name": "emphasis",
      "markdown": "Greet *each* caller, _politely_.",
      "text": "Greet each caller, politely."
    },
    {
      "name": "intraword star emphasis",
      "markdown": "foo*bar* and 2*3*4.",
      "text": "foobar and 234."
    },
    {
      "name": "intraword underscore is text",
      "markdown": "Keep snake_case_name and foo_bar_ as typed.",
      "text": "Keep snake_case_name and foo_bar_ as typed."
    },
    {
      "name": "underscore runs",
      "markdown": "_a_b_ and __a__b__.",
      "text": "a_b and a__b."
    },
    {
      "name": "spaced stars are text",
      "markdown": "a * b * c and a ** b.",
      "text": "a * b * c and a ** b."
    },
    {
      "name": "strikethrough",
      "markdown": "Greet ~~some~~ every ~one~ caller.",
      "text": "Greet some every one caller."
    },
    {
      "name": "uneven tildes are text",
      "markdown": "~~a~ and ~a~~ stay.",
      "text": "a~ and ~a stay."
    },
    {
      "name": "link",
      "markdown": "Greet as the [style guide](https://example.com/g) says.",
      "text": "Greet as the style guide says."
    },
    {
      "name": "link with title",
      "markdown": "See [the guide](https://example.com/g \"Guide\") now.",
      "text": "See the guide now."
    },
    {
      "name": "link with angle destination",
      "markdown": "See [the guide](<u v>) now.",
      "text": "See the guide now."
    },
    {
      "name": "image reads as its alt",
      "markdown": "A ![logo](img.png) here.",
      "text": "A logo here."
    },
    {
      "name": "empty link",
      "markdown": "Before [](u) after.",
      "text": "Before  after."
    },
    {
      "name": "autolink",
      "markdown": "Greet at <https://example.com/hi>.",
      "text": "Greet at https://example.com/hi."
    },
    {
      "name": "email autolink",
      "markdown": "Mail <ops@example.com> now.",
      "text": "Mail ops@example.com now."
    },
    {
      "name": "bare url",
      "markdown": "Visit https://example.com/q today.",
      "text": "Visit https://example.com/q today."
    },
    {
      "name": "source tag is text",
      "markdown": "Greet in English. [Brief · p.2]",
      "text": "Greet in English. [Brief · p.2]"
    },
    {
      "name": "escaped source tag",
      "markdown": "Every user signs in. \\[org default\\]",
      "text": "Every user signs in. [org default]"
    },
    {
      "name": "reference link without definition is text",
      "markdown": "See [text][ref] here.",
      "text": "See [text][ref] here."
    },
    {
      "name": "nested emphasis",
      "markdown": "Greet **bold *and* italic** and *it `code` it*.",
      "text": "Greet bold and italic and it code it."
    },
    {
      "name": "markup in a link",
      "markdown": "In [**b** `c` l](u) end.",
      "text": "In b c l end."
    },
    {
      "name": "triple stars",
      "markdown": "***both*** and *a **b** c*.",
      "text": "both and a b c."
    },
    {
      "name": "rule of three",
      "markdown": "a *b **c* d** and **foo*bar**.",
      "text": "a b c d and foo*bar."
    },
    {
      "name": "unmatched link then emphasis",
      "markdown": "[a *b](c) d*",
      "text": "a *b d*"
    },
    {
      "name": "code span beats emphasis",
      "markdown": "*foo`*`",
      "text": "*foo*"
    },
    {
      "name": "escaped stars are text",
      "markdown": "Keep \\*stars\\* as typed.",
      "text": "Keep *stars* as typed."
    },
    {
      "name": "unclosed markup is text",
      "markdown": "unclosed `tick and **bold and _x",
      "text": "unclosed `tick and **bold and _x"
    },
    {
      "name": "entities",
      "markdown": "Fish &amp; chips &lt;b&gt;",
      "text": "Fish & chips <b>"
    },
    {
      "name": "raw html is text",
      "markdown": "A <b>bold</b> word.",
      "text": "A <b>bold</b> word."
    },
    {
      "name": "closing tag",
      "markdown": "A rejected claim goes back. *assumed*",
      "text": "A rejected claim goes back. assumed",
      "tag": "assumed"
    },
    {
      "name": "closing tag after markup",
      "markdown": "Greet with a *friendly* `name`. *assumed*.",
      "text": "Greet with a friendly name. assumed.",
      "tag": "assumed"
    },
    {
      "name": "blocking tag",
      "markdown": "Does finance post to one Xero org? *blocking*",
      "text": "Does finance post to one Xero org? blocking",
      "tag": "blocking"
    },
    {
      "name": "tag not closing",
      "markdown": "An *assumed* word mid-line.",
      "text": "An assumed word mid-line."
    }
  ]
}
