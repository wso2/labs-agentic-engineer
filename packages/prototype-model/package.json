{
  "name": "@aep/prototype-model",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The versioned prototype model a web-application component's prototype.json follows: v1 types, the Zod schema and reference checks behind every gate, the deterministic serializer, the artifact path helpers, and the published JSON Schema.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fixtures/*": "./fixtures/*"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen": "tsx scripts/generate-json-schema.ts",
    "lint": "eslint .",
    "test": "tsx --test \"test/**/*.test.ts\"",
    "dev": "echo \"@aep/prototype-model: no dev server\""
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "tsx": "^4.21.0"
  }
}
