{
  "schemaVersion": 1,
  "component": "approvals-portal",
  "name": "Expense approvals",
  "defaultScreenId": "screen.queue",
  "roles": [
    {
      "id": "approver",
      "name": "Approver"
    },
    {
      "id": "employee",
      "name": "Employee"
    },
    {
      "id": "finance",
      "name": "Finance admin"
    }
  ],
  "states": [
    {
      "id": "state.default",
      "name": "Default"
    },
    {
      "id": "state.invalid",
      "name": "Validation errors"
    },
    {
      "id": "state.empty",
      "name": "Nothing to show"
    },
    {
      "id": "state.failed",
      "name": "Integration failed"
    }
  ],
  "flows": [
    {
      "id": "flow.approve",
      "name": "Approve an expense",
      "roleId": "approver",
      "screenIds": [
        "screen.queue",
        "screen.detail"
      ]
    },
    {
      "id": "flow.submit",
      "name": "Submit an expense",
      "roleId": "employee",
      "screenIds": [
        "screen.new",
        "screen.mine"
      ]
    },
    {
      "id": "flow.month-end",
      "name": "Month-end review",
      "roleId": "finance",
      "screenIds": [
        "screen.reports",
        "screen.detail"
      ]
    }
  ],
  "screens": [
    {
      "id": "screen.queue",
      "name": "Approval queue",
      "roleIds": [
        "approver",
        "finance"
      ],
      "navigationId": "nav.main",
      "content": [
        {
          "kind": "heading",
          "id": "heading.queue",
          "text": "Approval queue",
          "actions": [
            {
              "id": "btn.export",
              "label": "Export",
              "action": {
                "kind": "show-drawer",
                "drawerId": "drawer.export"
              }
            }
          ]
        },
        {
          "kind": "alert",
          "id": "alert.sync-failed",
          "tone": "error",
          "title": "Expense feed unavailable",
          "text": "The ERP integration has not responded since 08:12. Amounts may be stale.",
          "showIn": [
            "state.failed"
          ]
        },
        {
          "kind": "grid",
          "id": "grid.stats",
          "columns": 3,
          "content": [
            {
              "kind": "stat",
              "id": "stat.pending",
              "label": "Awaiting approval",
              "value": "12"
            },
            {
              "kind": "stat",
              "id": "stat.overdue",
              "label": "Overdue",
              "value": "3"
            },
            {
              "kind": "stat",
              "id": "stat.total",
              "label": "This month",
              "value": "$18,420"
            }
          ]
        },
        {
          "kind": "filters",
          "id": "filters.queue",
          "fields": [
            {
              "id": "filter.status",
              "label": "Status",
              "type": "select",
              "value": "Awaiting approval",
              "options": [
                "Awaiting approval",
                "Approved",
                "Rejected"
              ]
            },
            {
              "id": "filter.team",
              "label": "Team",
              "type": "select",
              "value": "All teams",
              "options": [
                "All teams",
                "Platform",
                "Sales"
              ]
            },
            {
              "id": "filter.overdue",
              "label": "Overdue only",
              "type": "switch",
              "value": "off"
            }
          ]
        },
        {
          "kind": "task-queue",
          "id": "queue.expenses",
          "title": "Expenses",
          "columns": [
            "Employee",
            "Amount",
            "Category",
            "Submitted",
            "Status"
          ],
          "rows": [
            {
              "id": "expense.1042",
              "values": {
                "Employee": "Maya Fernando",
                "Amount": "$148.20",
                "Category": "Travel",
                "Submitted": "2 days ago",
                "Status": "Awaiting approval"
              }
            },
            {
              "id": "expense.1041",
              "values": {
                "Employee": "Dilan Perera",
                "Amount": "$1,250.00",
                "Category": "Conference",
                "Submitted": "3 days ago",
                "Status": "Awaiting approval"
              },
              "tone": "warning"
            },
            {
              "id": "expense.1039",
              "values": {
                "Employee": "Sara Kim",
                "Amount": "$32.90",
                "Category": "Meals",
                "Submitted": "6 days ago",
                "Status": "Overdue"
              },
              "tone": "error"
            },
            {
              "id": "expense.1038",
              "values": {
                "Employee": "Ravi Nair",
                "Amount": "$410.00",
                "Category": "Equipment",
                "Submitted": "1 week ago",
                "Status": "Overdue"
              },
              "tone": "error"
            }
          ],
          "onRow": {
            "kind": "navigate",
            "screenId": "screen.detail"
          },
          "showIn": [
            "state.default",
            "state.invalid",
            "state.failed"
          ]
        },
        {
          "kind": "link",
          "id": "link.oldest",
          "label": "Jump to the oldest overdue claim",
          "action": {
            "kind": "select-row",
            "tableId": "queue.expenses",
            "rowId": "expense.1038"
          },
          "showIn": [
            "state.default",
            "state.invalid",
            "state.failed"
          ]
        },
        {
          "kind": "empty-state",
          "id": "empty.queue",
          "title": "Nothing waiting",
          "text": "Every expense has been decided. New submissions land here.",
          "action": {
            "id": "btn.empty.reports",
            "label": "Open reports",
            "action": {
              "kind": "navigate",
              "screenId": "screen.reports"
            }
          },
          "showIn": [
            "state.empty"
          ]
        }
      ],
      "overlays": [
        {
          "kind": "drawer",
          "id": "drawer.export",
          "title": "Export queue",
          "content": [
            {
              "kind": "text",
              "id": "text.export",
              "text": "Choose a format. The export is prepared in the background and emailed to you."
            },
            {
              "kind": "form",
              "id": "form.export",
              "fields": [
                {
                  "id": "field.format",
                  "label": "Format",
                  "type": "select",
                  "value": "CSV",
                  "options": [
                    "CSV",
                    "XLSX"
                  ]
                }
              ],
              "actions": [
                {
                  "id": "btn.export.go",
                  "label": "Prepare export",
                  "emphasis": "primary",
                  "action": {
                    "kind": "close-overlay"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "screen.detail",
      "name": "Expense detail",
      "roleIds": [
        "approver",
        "finance"
      ],
      "navigationId": "nav.main",
      "content": [
        {
          "kind": "breadcrumbs",
          "id": "crumbs.detail",
          "items": [
            {
              "id": "crumb.queue",
              "label": "Approval queue",
              "action": {
                "kind": "navigate",
                "screenId": "screen.queue"
              }
            },
            {
              "id": "crumb.detail",
              "label": "#1042"
            }
          ]
        },
        {
          "kind": "stack",
          "id": "stack.detail-title",
          "direction": "row",
          "content": [
            {
              "kind": "heading",
              "id": "heading.detail",
              "text": "Expense #1042 · Maya Fernando"
            },
            {
              "kind": "badge",
              "id": "badge.status",
              "label": "Awaiting approval",
              "tone": "warning"
            }
          ]
        },
        {
          "kind": "split",
          "id": "split.detail",
          "ratio": 7,
          "left": [
            {
              "kind": "detail",
              "id": "detail.expense",
              "title": "Claim",
              "fields": [
                {
                  "label": "Amount",
                  "value": "$148.20"
                },
                {
                  "label": "Category",
                  "value": "Travel"
                },
                {
                  "label": "Cost centre",
                  "value": "PLAT-220"
                },
                {
                  "label": "Receipt",
                  "value": "taxi-2026-09-18.pdf"
                },
                {
                  "label": "Note",
                  "value": "Airport taxi after the customer workshop."
                }
              ]
            },
            {
              "kind": "timeline",
              "id": "timeline.expense",
              "entries": [
                {
                  "id": "tl.submitted",
                  "when": "Sep 18, 17:40",
                  "who": "Maya Fernando",
                  "text": "Submitted the claim"
                },
                {
                  "id": "tl.policy",
                  "when": "Sep 18, 17:41",
                  "who": "Policy check",
                  "text": "Within policy"
                },
                {
                  "id": "tl.opened",
                  "when": "Sep 19, 09:02",
                  "who": "You",
                  "text": "Opened for review"
                }
              ]
            }
          ],
          "right": [
            {
              "kind": "approval-panel",
              "id": "approval.expense",
              "title": "Decision",
              "summary": "Within policy. No duplicate found in the last 90 days.",
              "actions": [
                {
                  "id": "btn.approve",
                  "label": "Approve",
                  "emphasis": "primary",
                  "action": {
                    "kind": "show-dialog",
                    "dialogId": "dialog.approve"
                  }
                },
                {
                  "id": "btn.reject",
                  "label": "Reject",
                  "emphasis": "danger",
                  "action": {
                    "kind": "show-dialog",
                    "dialogId": "dialog.reject"
                  }
                }
              ]
            }
          ]
        }
      ],
      "overlays": [
        {
          "kind": "dialog",
          "id": "dialog.approve",
          "title": "Approve expense #1042?",
          "content": [
            {
              "kind": "text",
              "id": "text.approve",
              "text": "$148.20 will be scheduled for the next payroll run. This preview changes nothing."
            }
          ],
          "actions": [
            {
              "id": "btn.approve.cancel",
              "label": "Cancel",
              "action": {
                "kind": "close-overlay"
              }
            },
            {
              "id": "btn.approve.confirm",
              "label": "Approve",
              "emphasis": "primary",
              "action": {
                "kind": "close-overlay"
              }
            }
          ]
        },
        {
          "kind": "dialog",
          "id": "dialog.reject",
          "title": "Reject expense #1042",
          "content": [
            {
              "kind": "form",
              "id": "form.reject",
              "fields": [
                {
                  "id": "field.reason",
                  "label": "Reason",
                  "type": "textarea",
                  "error": "Give the employee a reason",
                  "errorIn": [
                    "state.invalid"
                  ]
                }
              ],
              "actions": []
            }
          ],
          "actions": [
            {
              "id": "btn.reject.cancel",
              "label": "Cancel",
              "action": {
                "kind": "close-overlay"
              }
            },
            {
              "id": "btn.reject.confirm",
              "label": "Reject",
              "emphasis": "danger",
              "action": {
                "kind": "close-overlay"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "screen.new",
      "name": "New expense",
      "roleIds": [
        "employee"
      ],
      "navigationId": "nav.main",
      "content": [
        {
          "kind": "heading",
          "id": "heading.new",
          "text": "New expense"
        },
        {
          "kind": "validation-summary",
          "id": "validation.new",
          "issues": [
            "Amount must be greater than zero",
            "A receipt is required over $25"
          ],
          "showIn": [
            "state.invalid"
          ]
        },
        {
          "kind": "stepper",
          "id": "stepper.new",
          "steps": [
            {
              "id": "step.details",
              "label": "Details",
              "content": [
                {
                  "kind": "form",
                  "id": "form.details",
                  "fields": [
                    {
                      "id": "field.amount",
                      "label": "Amount",
                      "type": "number",
                      "value": "0.00",
                      "error": "Must be greater than zero",
                      "errorIn": [
                        "state.invalid"
                      ]
                    },
                    {
                      "id": "field.category",
                      "label": "Category",
                      "type": "select",
                      "value": "Travel",
                      "options": [
                        "Travel",
                        "Meals",
                        "Equipment",
                        "Conference"
                      ]
                    },
                    {
                      "id": "field.date",
                      "label": "Date",
                      "type": "date",
                      "value": "2026-09-18"
                    },
                    {
                      "id": "field.note",
                      "label": "Note",
                      "type": "textarea"
                    }
                  ],
                  "actions": [
                    {
                      "id": "btn.next",
                      "label": "Next",
                      "emphasis": "primary",
                      "action": {
                        "kind": "set-step",
                        "stepperId": "stepper.new",
                        "stepId": "step.receipt"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "step.receipt",
              "label": "Receipt",
              "content": [
                {
                  "kind": "text",
                  "id": "text.receipt",
                  "text": "Attach the receipt. Photos and PDFs are accepted."
                },
                {
                  "kind": "form",
                  "id": "form.receipt",
                  "fields": [
                    {
                      "id": "field.receipt",
                      "label": "Receipt file",
                      "value": "taxi-2026-09-18.pdf",
                      "error": "A receipt is required over $25",
                      "errorIn": [
                        "state.invalid"
                      ]
                    }
                  ],
                  "actions": [
                    {
                      "id": "btn.back",
                      "label": "Back",
                      "action": {
                        "kind": "set-step",
                        "stepperId": "stepper.new",
                        "stepId": "step.details"
                      }
                    },
                    {
                      "id": "btn.review",
                      "label": "Review",
                      "emphasis": "primary",
                      "action": {
                        "kind": "set-step",
                        "stepperId": "stepper.new",
                        "stepId": "step.review"
                      }
                    }
                  ]
                }
              ]
            },
            {
              "id": "step.review",
              "label": "Review",
              "content": [
                {
                  "kind": "detail",
                  "id": "detail.review",
                  "title": "Summary",
                  "fields": [
                    {
                      "label": "Amount",
                      "value": "$148.20"
                    },
                    {
                      "label": "Category",
                      "value": "Travel"
                    },
                    {
                      "label": "Receipt",
                      "value": "taxi-2026-09-18.pdf"
                    }
                  ]
                },
                {
                  "kind": "button",
                  "id": "btn.submit",
                  "label": "Submit for approval",
                  "emphasis": "primary",
                  "action": {
                    "kind": "show-dialog",
                    "dialogId": "dialog.submitted"
                  }
                }
              ]
            }
          ]
        }
      ],
      "overlays": [
        {
          "kind": "dialog",
          "id": "dialog.submitted",
          "title": "Submitted",
          "content": [
            {
              "kind": "text",
              "id": "text.submitted",
              "text": "Your claim is with your approver. Nothing was actually sent in this preview."
            }
          ],
          "actions": [
            {
              "id": "btn.submitted.ok",
              "label": "Go to my expenses",
              "emphasis": "primary",
              "action": {
                "kind": "navigate",
                "screenId": "screen.mine"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "screen.mine",
      "name": "My expenses",
      "roleIds": [
        "employee"
      ],
      "navigationId": "nav.main",
      "content": [
        {
          "kind": "heading",
          "id": "heading.mine",
          "text": "My expenses",
          "actions": [
            {
              "id": "btn.new",
              "label": "New expense",
              "emphasis": "primary",
              "action": {
                "kind": "navigate",
                "screenId": "screen.new"
              }
            },
            {
              "id": "btn.paid",
              "label": "Show paid",
              "action": {
                "kind": "set-tab",
                "tabsId": "tabs.mine",
                "tabId": "tab.paid"
              }
            }
          ]
        },
        {
          "kind": "tabs",
          "id": "tabs.mine",
          "tabs": [
            {
              "id": "tab.open",
              "label": "Open",
              "content": [
                {
                  "kind": "table",
                  "id": "table.mine.open",
                  "columns": [
                    "Reference",
                    "Amount",
                    "Category",
                    "Status"
                  ],
                  "rows": [
                    {
                      "id": "mine.1042",
                      "values": {
                        "Reference": "#1042",
                        "Amount": "$148.20",
                        "Category": "Travel",
                        "Status": "Awaiting approval"
                      }
                    },
                    {
                      "id": "mine.1030",
                      "values": {
                        "Reference": "#1030",
                        "Amount": "$65.00",
                        "Category": "Meals",
                        "Status": "Needs receipt"
                      },
                      "tone": "warning"
                    }
                  ]
                }
              ]
            },
            {
              "id": "tab.paid",
              "label": "Paid",
              "content": [
                {
                  "kind": "table",
                  "id": "table.mine.paid",
                  "columns": [
                    "Reference",
                    "Amount",
                    "Paid on"
                  ],
                  "rows": [
                    {
                      "id": "mine.1001",
                      "values": {
                        "Reference": "#1001",
                        "Amount": "$220.00",
                        "Paid on": "Aug 28"
                      }
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "screen.reports",
      "name": "Reports",
      "roleIds": [
        "finance"
      ],
      "navigationId": "nav.main",
      "content": [
        {
          "kind": "heading",
          "id": "heading.reports",
          "text": "Month-end report"
        },
        {
          "kind": "alert",
          "id": "alert.reports.failed",
          "tone": "warning",
          "text": "Ledger sync is delayed. Totals exclude the last 4 hours.",
          "showIn": [
            "state.failed"
          ]
        },
        {
          "kind": "grid",
          "id": "grid.reports",
          "columns": 3,
          "content": [
            {
              "kind": "stat",
              "id": "stat.approved",
              "label": "Approved",
              "value": "$14,980"
            },
            {
              "kind": "stat",
              "id": "stat.rejected",
              "label": "Rejected",
              "value": "$1,120"
            },
            {
              "kind": "stat",
              "id": "stat.still-pending",
              "label": "Still pending",
              "value": "$2,320"
            }
          ]
        },
        {
          "kind": "table",
          "id": "table.by-team",
          "title": "By team",
          "columns": [
            "Team",
            "Claims",
            "Approved",
            "Rejected"
          ],
          "rows": [
            {
              "id": "team.platform",
              "values": {
                "Team": "Platform",
                "Claims": "24",
                "Approved": "$8,410",
                "Rejected": "$320"
              }
            },
            {
              "id": "team.sales",
              "values": {
                "Team": "Sales",
                "Claims": "31",
                "Approved": "$6,570",
                "Rejected": "$800"
              }
            }
          ],
          "onRow": {
            "kind": "navigate",
            "screenId": "screen.detail"
          }
        },
        {
          "kind": "empty-state",
          "id": "empty.reports",
          "title": "No claims this month",
          "text": "Reports fill in as claims are decided.",
          "showIn": [
            "state.empty"
          ]
        },
        {
          "kind": "link",
          "id": "link.policy",
          "label": "Review the approval queue",
          "action": {
            "kind": "navigate",
            "screenId": "screen.queue"
          }
        }
      ]
    }
  ],
  "navigation": [
    {
      "kind": "side-nav",
      "id": "nav.main",
      "items": [
        {
          "id": "nav.queue",
          "label": "Approval queue",
          "action": {
            "kind": "navigate",
            "screenId": "screen.queue"
          },
          "roleIds": [
            "approver",
            "finance"
          ]
        },
        {
          "id": "nav.mine",
          "label": "My expenses",
          "action": {
            "kind": "navigate",
            "screenId": "screen.mine"
          },
          "roleIds": [
            "employee"
          ]
        },
        {
          "id": "nav.new",
          "label": "New expense",
          "action": {
            "kind": "navigate",
            "screenId": "screen.new"
          },
          "roleIds": [
            "employee"
          ]
        },
        {
          "id": "nav.reports",
          "label": "Reports",
          "action": {
            "kind": "navigate",
            "screenId": "screen.reports"
          },
          "roleIds": [
            "finance"
          ]
        }
      ]
    }
  ]
}
