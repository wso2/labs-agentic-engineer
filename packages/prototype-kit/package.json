{
  "name": "@wso2/prototype-kit",
  "version": "0.1.0",
  "type": "module",
  "license": "Apache-2.0",
  "description": "The kit a generated prototype is written against (defineApp, hooks, a mock data store, neutral components), plus the manifest schema, the source and render checks, the sandboxed frame host and the theme build helper.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./manifest": {
      "types": "./dist/manifest/index.d.ts",
      "default": "./dist/manifest/index.js"
    },
    "./manifest/schema.json": "./schema/prototype-manifest.schema.json",
    "./source": {
      "types": "./dist/source/index.d.ts",
      "default": "./dist/source/index.js"
    },
    "./check": {
      "types": "./dist/check/index.d.ts",
      "default": "./dist/check/index.js"
    },
    "./host": {
      "types": "./dist/host/index.d.ts",
      "default": "./dist/host/index.js"
    },
    "./feedback": {
      "types": "./dist/feedback/index.d.ts",
      "default": "./dist/feedback/index.js"
    },
    "./build": {
      "types": "./dist/bundle/index.d.ts",
      "default": "./dist/bundle/index.js"
    },
    "./build/frame-entry": {
      "types": "./dist/bundle/frame-entry.d.ts",
      "default": "./dist/bundle/frame-entry.js"
    },
    "./build/check-entry": {
      "types": "./dist/bundle/check-entry.d.ts",
      "default": "./dist/bundle/check-entry.js"
    },
    "./build/check-prelude": {
      "types": "./dist/bundle/check-prelude.d.ts",
      "default": "./dist/bundle/check-prelude.js"
    },
    "./reference.md": "./reference.md",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "reference.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "gen": "tsx scripts/generate.ts",
    "lint": "eslint .",
    "test": "vitest run",
    "dev": "echo \"@wso2/prototype-kit: no dev server\""
  },
  "dependencies": {
    "acorn": "^8.17.0",
    "acorn-walk": "^8.3.5",
    "sucrase": "^3.35.1",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "esbuild": ">=0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "peerDependenciesMeta": {
    "esbuild": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.0.2",
    "esbuild": "^0.28.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tsx": "^4.21.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
