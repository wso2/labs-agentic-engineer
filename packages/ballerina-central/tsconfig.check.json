{
  // Typecheck the WHOLE package — tests and dev scripts included. `tsconfig.json`
  // deliberately covers only `src` because it is the one that emits `dist`, and
  // test files have no business there.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["src", "test", "scripts"]
}
