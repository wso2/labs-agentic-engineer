{
  "idp": "thunder",
  "about": "How a ThunderID token names the caller's org and caller type, with sample token payloads and how every reader of the platform IdP's tokens must read them. caller is user, machine or refused. orgHandle is the handle of the one org the sample install serves: a reader that maps the install's org (aep-api) reads a token of any other org as no org at all.",
  "orgHandle": "default",
  "claims": {
    "org": {
      "handle": "ouHandle",
      "id": "ouId",
      "name": "ouName"
    },
    "callerType": {
      "claim": "grant_type",
      "machine": "client_credentials"
    }
  },
  "tokens": [
    {
      "name": "a user who signed in",
      "payload": {
        "sub": "5a1b9c0e-user",
        "aud": "aep-console-client",
        "client_id": "aep-console-client",
        "grant_type": "authorization_code",
        "ouId": "0195a3c1-7d2e-7c41-9b8a-2f6d4e8a1c30",
        "ouHandle": "default",
        "ouName": "Default",
        "name": "Ada Lovelace"
      },
      "org": {
        "handle": "default",
        "id": "0195a3c1-7d2e-7c41-9b8a-2f6d4e8a1c30",
        "name": "Default"
      },
      "caller": "user"
    },
    {
      "name": "the same user after a token refresh",
      "payload": {
        "sub": "5a1b9c0e-user",
