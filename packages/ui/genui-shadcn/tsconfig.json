{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "dist",
    "noEmit": false,
    // Read only by the shadcn CLI, to find where its components.json aliases
    // land. TypeScript itself resolves #shadcn/* through package.json imports.
    "paths": {
      "#shadcn/*": ["./src/vendor/shadcn/*"]
    }
  },
  "include": ["src"]
}
