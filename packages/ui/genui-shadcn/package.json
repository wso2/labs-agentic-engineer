{
  "name": "@aep/ui-genui-shadcn",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The @aep/ui-genui catalog implemented with shadcn/ui, shipped with a prebuilt, scoped stylesheet.",
  "main": "src/index.tsx",
  "types": "src/index.tsx",
  "exports": {
    ".": "./src/index.tsx",
    "./styles.css": "./dist/genui-shadcn.css"
  },
  "imports": {
    "#shadcn/components/ui/*": "./src/vendor/shadcn/components/ui/*.tsx",
    "#shadcn/lib/*": "./src/vendor/shadcn/lib/*.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && pnpm run build:css",
    "build:css": "tailwindcss -i src/styles.css -o dist/genui-shadcn.css --minify",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@aep/ui-genui": "workspace:*",
    "class-variance-authority": "0.7.1",
    "cn": "0.4.0",
    "lucide-react": "1.47.0",
    "radix-ui": "1.6.7"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.0.2",
    "jsdom": "26.1.0",
    "shadcn": "4.21.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.10"
  }
}
