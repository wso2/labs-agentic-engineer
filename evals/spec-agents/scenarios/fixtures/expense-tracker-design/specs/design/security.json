{
  "version": 3,
  "permissions": [
    {
      "resource": "claims",
      "component": "expense-api",
      "description": "Expense claims and their decisions",
      "actions": [
        { "handle": "read", "description": "The caller's own claims" },
        { "handle": "read-all", "description": "Every claim" },
        { "handle": "submit", "description": "File a new claim" },
        { "handle": "approve", "description": "Approve a submitted claim" },
        { "handle": "reject", "description": "Reject a submitted claim with a reason" }
      ]
    },
    {
      "resource": "reports",
      "component": "expense-api",
      "description": "The monthly total of approved claims",
      "actions": [
        { "handle": "read", "description": "Monthly total of approved claims" }
      ]
    }
  ],
  "groups": [
    { "name": "Employees", "description": "People who file expense claims" },
    { "name": "Approvers", "description": "People who decide submitted claims and read monthly totals" }
  ],
  "roles": [
    {
      "name": "Employee",
      "description": "Files expense claims and follows the status of their own claims.",
      "stories": ["F1.1", "F1.2", "F1.3"],
      "grants": ["claims:read", "claims:submit"],
      "assignTo": ["Employees"]
    },
    {
      "name": "Approver",
      "description": "Works the queue of submitted claims, decides each one, and reads the monthly totals.",
      "stories": ["F2.1", "F2.2", "F2.3", "F3.1"],
      "grants": ["claims:read-all", "claims:approve", "claims:reject", "reports:read"],
      "assignTo": ["Approvers"]
    }
  ],
  "testUsers": [
    { "username": "test-employee", "roles": ["Employee"] },
    { "username": "test-employee-2", "roles": ["Employee"] },
    { "username": "test-approver", "roles": ["Approver"] }
  ]
}
