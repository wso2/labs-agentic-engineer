title Onboarding Tracker

component onboarding-webapp as "Onboarding Tracker" web-application
component onboarding-api as "Onboarding API" service
component onboarding-db as "Onboarding Database" database

east onboarding-auth as "Thunder Auth" identity-server

west -> onboarding-webapp

onboarding-webapp -> onboarding-api
onboarding-webapp -> onboarding-auth
onboarding-api -> onboarding-auth
onboarding-api -> onboarding-db
