  {
   "type": "text",
   "id": "legA",
   "x": 60,
   "y": 1090,
   "width": 504.0,
   "height": 30.0,
   "strokeColor": "#b91c1c",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 1048,
   "version": 1,
   "versionNonce": 7336,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Secrets are held in the wrong place",
   "originalText": "Secrets are held in the wrong place",
   "fontSize": 24,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "listA",
   "x": 60,
   "y": 1130,
   "width": 806.4,
   "height": 300.0,
   "strokeColor": "#64748b",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 1049,
   "version": 1,
   "versionNonce": 7343,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "1  Secret values are kept in the control-plane database.\n   Vault only gets a copy, and only if that copy works.\n2  aep-api decrypts the GitHub token and uses it itself\n3  To run the AI, aep-api takes the Anthropic key out\n   of the database and sends it along with every chat\n   turn, unencrypted inside the cluster.\n4  The coding agent (an AI with a shell) can read every\n   secret it is given: GitHub token, Thunder client\n   secret, Anthropic key. A prompt injection can send\n   them out.",
   "originalText": "1  Secret values are kept in the control-plane database.\n   Vault only gets a copy, and only if that copy works.\n2  aep-api decrypts the GitHub token and uses it itself\n3  To run the AI, aep-api takes the Anthropic key out\n   of the database and sends it along with every chat\n   turn, unencrypted inside the cluster.\n4  The coding agent (an AI with a shell) can read every\n   secret it is given: GitHub token, Thunder client\n   secret, Anthropic key. A prompt injection can send\n   them out.",
   "fontSize": 24,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
  {
   "type": "text",
   "id": "legB",
   "x": 1200,
   "y": 1090,
   "width": 446.4,
   "height": 30.0,
   "strokeColor": "#b45309",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 0,
   "opacity": 100,
   "angle": 0,
   "seed": 1050,
   "version": 1,
   "versionNonce": 7350,
   "isDeleted": false,
   "groupIds": [],
   "boundElements": null,
   "link": null,
   "locked": false,
   "text": "Someone can act as someone else",
   "originalText": "Someone can act as someone else",
   "fontSize": 24,
   "fontFamily": 3,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "lineHeight": 1.25
  },
